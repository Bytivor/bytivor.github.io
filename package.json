{
  "name": "bytivor-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "hexo clean && hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "dev": "hexo server --ip 127.0.0.1 --port 4000",
    "check": "node tools/check-site.cjs",
    "predev": "node tools/prepare-assets.cjs",
    "prebuild": "node tools/prepare-assets.cjs",
    "build:preview": "node tools/prepare-assets.cjs && hexo clean && hexo generate --config _config.yml,_config.preview.yml"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "hexo": "^8.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "4.10.0",
    "hexo-theme-landscape": "^1.0.0",
    "medium-zoom": "1.1.0"
  }
}
